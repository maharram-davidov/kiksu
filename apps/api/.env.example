# Kiksu API — environment variables.
#
# Copy to `.env` and fill in real values for local development. NEVER commit `.env`
# (the root .gitignore already excludes it). This file documents the SHAPE only —
# every value below is a placeholder.
#
# Validated at boot by src/config/env.schema.ts — a missing or malformed variable
# crashes the process on startup rather than failing on the first request that needs it.

NODE_ENV=development
PORT=3000

# --- Supabase project (docs/04-infrastructure.md: ref houicgsdduzzcarxkuuo, eu-central-1) ---
SUPABASE_URL=https://houicgsdduzzcarxkuuo.supabase.co

# SECURITY: server-only. This key bypasses every RLS policy in the database
# (kiksu_app holds bypassrls — 01-schema-notes.md). It must NEVER be sent to the Expo
# app, logged, put in a response, or put in a URL. A leaked service-role key voids
# every identity protection in 02-identity-spec.md. Get the real value from the
# Supabase dashboard (Project Settings > API) or from the team's secrets manager —
# never from a file that could be committed.
SUPABASE_SERVICE_ROLE_KEY=replace-with-real-service-role-key

# Optional override; defaults to `${SUPABASE_URL}/auth/v1/.well-known/jwks.json`.
# SUPABASE_JWKS_URL=

# Expected `aud` claim on Supabase access tokens. Supabase's default is "authenticated".
SUPABASE_JWT_AUDIENCE=authenticated

# --- Keyset pagination cursor signing (05-api-conventions.md §4.3) ---
# 32+ random bytes, any encoding (hex/base64 both fine as long as the resulting string
# is >= 32 chars). Generate with: openssl rand -hex 32
# Rotating this invalidates every outstanding cursor — clients see cursor_invalid and
# restart their list, which is a graceful (if slightly annoying) degradation.
CURSOR_HMAC_SECRET=replace-with-32-plus-bytes-of-random-data

# --- Idempotency store (05-api-conventions.md §6) ---
# "memory" = single-process only, lost on restart. Fine for dev/test. A multi-instance
# production deploy needs "redis" (not yet implemented — see
# src/common/idempotency/idempotency.store.ts).
IDEMPOTENCY_STORE=memory
# REDIS_URL=redis://localhost:6379

# --- Rate limiting (05-api-conventions.md §5) ---
# Same caveat as IDEMPOTENCY_STORE.
RATE_LIMIT_STORE=memory

# --- App store URLs, surfaced via GET /v1/bootstrap ---
IOS_STORE_URL=https://apps.apple.com/az/app/kiksu/id0000000000
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=az.kiksu.app

# --- Client version gating, surfaced via GET /v1/bootstrap (05-api-conventions.md §1.3/§1.5) ---
# Semver strings. Raising MIN_SUPPORTED_CLIENT_* is how a build gets force-upgraded
# without a deploy of this service.
MIN_SUPPORTED_CLIENT_IOS=1.0.0
MIN_SUPPORTED_CLIENT_ANDROID=1.0.0
RECOMMENDED_CLIENT_IOS=1.0.0
RECOMMENDED_CLIENT_ANDROID=1.0.0
