{
  "name": "@kiksu/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kiksu server layer — the API every client write and identity-sensitive read passes through.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "prestart": "npm run build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@types/nodemailer": "^8.0.1",
    "dotenv": "^16.4.7",
    "jose": "^5.9.6",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
